# =============================================================================
# SessionAI environment variables
# =============================================================================
# Copy relevant sections into:
#   apps/api/.env
#   apps/mobile/.env
#
# MOBILE-SAFE (may be EXPO_PUBLIC_*):
#   EXPO_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY
#   EXPO_PUBLIC_API_BASE_URL
#
# SERVER-ONLY (never EXPO_PUBLIC_*, never ship in the mobile bundle):
#   SUPABASE_SERVICE_ROLE_KEY
#   ANTHROPIC_API_KEY
#   TRANSCRIPTION_API_KEY
#
# Production notes: see docs/production.md
# =============================================================================

# --- Shared Supabase project ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=3847
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
LOG_SENSITIVE=false

# --- Mobile (apps/mobile/.env) ---
# Use https://your-api.example.com in production builds (no trailing slash).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3847
