{
  "expo": {
    "name": "SessionAI",
    "slug": "sessionai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/transio_logo.jpg",
    "scheme": "sessionai",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sessionai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SessionAI needs microphone access to record seminars, lectures, and group discussions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E313B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.sessionai.app",
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transio_logo.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#1E313B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SessionAI needs microphone access to record seminars, lectures, and group discussions.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
