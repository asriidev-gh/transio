{
  "expo": {
    "name": "SessionAI",
    "slug": "sessionai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sessionai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sessionai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SessionAI needs microphone access to record seminars, lectures, and group discussions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2A24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.sessionai.app",
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F2A24"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SessionAI needs microphone access to record seminars, lectures, and group discussions.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
