# Mobile-safe public environment variables only.
# Copy to apps/mobile/.env
# Production: see docs/production.md

# Supabase — public anon key is OK in the client; NEVER put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK key for Android: goog_... for production, test_... for the Test Store.
# Never ship a release build with a Test Store key. Set it in the EAS environment for builds.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=smarttranscriber_pro

# SessionAI API (use your machine LAN IP for a physical Android/iOS device)
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3847
# See docs/android.md
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3847
