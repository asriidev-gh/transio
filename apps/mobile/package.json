{
  "name": "@sessionai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 19047",
    "android": "expo start --android --port 19047",
    "ios": "expo start --ios --port 19047",
    "web": "expo start --web --port 19047",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --max-warnings=0",
    "test": "bash -c 'node --import tsx --test $(find src -name \"*.test.ts\" | sort)'",
    "eas-build-post-install": "cd ../.. && npm run build --workspace=@sessionai/shared"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sessionai/shared": "*",
    "@supabase/supabase-js": "^2.49.1",
