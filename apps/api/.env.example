# Server-only environment variables for @sessionai/api
# Copy to apps/api/.env and fill in values. Never commit real secrets.

NODE_ENV=development
PORT=3847

# Supabase (server)
# Safe to mirror URL + anon key from mobile; service role is SERVER ONLY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI / transcription (SERVER ONLY — never EXPO_PUBLIC_*)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Faster model for Translate + Live Note Taker (Haiku).
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5
TRANSCRIPTION_API_KEY=
# Optional OpenAI-compatible base URL (default https://api.openai.com/v1)
TRANSCRIPTION_BASE_URL=
# whisper (default) or deepgram (speaker diarization, better for meetings; needs DEEPGRAM_API_KEY)
TRANSCRIPTION_PROVIDER=whisper
# Live captions WebSocket proxy (Deepgram Listen). Never EXPO_PUBLIC_*.
DEEPGRAM_API_KEY=

# Optional: install ffmpeg on the API host so video uploads are converted
# to compact speech audio before Whisper (recommended for mp4/mov).

# Comma-separated browser origins allowed to call the API (CORS).
# Empty in development = allow all. In production, set explicitly.
# Example: https://app.example.com,http://localhost:8081
CORS_ORIGINS=
# Max raw upload / link download in MB before ffmpeg conversion (default 100)
# MAX_UPLOAD_MB=100
# Optional path to ffmpeg; the API bundles ffmpeg-static by default
# FFMPEG_PATH=

# Usage quotas. off = none, log = count and log only (default), on = block over-limit requests.
# Keep log until billing is live, then switch to on.
# QUOTA_MODE=log
# FREE_LIMIT=2
# PRO_DAILY_LIMIT=5
# Spend kill switch: max uses per feature per UTC day across all users.
# GLOBAL_DAILY_LIMITS=session=300,summary=300,voiceTranslate=3000
# Random secret for hashing device ids. Required in production; do not change it later.
# DEVICE_HASH_SECRET=

# Load and abuse limits (defaults shown)
# JOB_CONCURRENCY=2
# MAX_CONCURRENT_UPLOADS=2
# JOB_STALE_MINUTES=30
# MAX_LIVE_STREAMS_PER_USER=2
# LIVE_MAX_MINUTES=180
