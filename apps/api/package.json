{
  "name": "@sessionai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "bash -c 'node --import tsx --test $(find src -name \"*.test.ts\" | sort)'"
  },
  "dependencies": {
    "@sessionai/shared": "*",
    "@supabase/supabase-js": "^2.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "typescript": "^5.7.3",
    "undici": "^7.29.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
